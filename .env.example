# ============================================
# AUBA Beauty Studio — Variables de entorno
# ============================================
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# ---- Base de datos (OBLIGATORIA) ----
# PostgreSQL. Sirve tanto Supabase como Neon, Railway, Render o cualquier
# Postgres. URL con SSL. En Supabase usa el pooler de transactions para serverless.
SUPABASE_DB_URL=postgresql://usuario:password@host:puerto/postgres?sslmode=require

# ---- Servidor ----
PORT=3000
NODE_ENV=development

# ---- Seguridad (OBLIGATORIA) ----
# Origen con coma. Debe incluir el dominio real; en producción el front y la API
# comparten dominio, así que basta con el dominio principal y su www.
ALLOWED_ORIGINS=https://aubaestudio.com,https://www.aubaestudio.com

# Firma de los JWT. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_AQUI

# ---- Administrador (OBLIGATORIAS) ----
ADMIN_PHONE=3001234567
ADMIN_PASSWORD=CONTRASENA_FUERTE_UNICA

# ---- Nequi (abono de $20.000) ----
NEQUI_NUMBER=3001234567

# ---- Cloudinary (comprobantes de pago) ----
# Si faltan, la subida de comprobantes queda deshabilitada.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ---- WhatsApp Business Cloud API (opcional) ----
# Sin WHATSAPP_TOKEN el servicio cae automáticamente a enlaces wa.me.
WHATSAPP_TOKEN=tu_whatsapp_token
WHATSAPP_PHONE_ID=tu_phone_id
WHATSAPP_BUSINESS_PHONE=573134672623
