# ============================================
# AUBA Beauty Studio — Variables para Vercel (producción)
# ============================================
# Define estas variables en el panel de Vercel (Settings > Environment Variables).
# NO subas un archivo .env al repositorio.

# ---- Base de datos (OBLIGATORIA) ----
# En Supabase, usa el pooler de "Transaction" (puerto 5432) en vez de la
# conexión directa: las funciones serverless abren y cierran conexiones por
# petición y agotan el pool directo muy rápido.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Seguridad (OBLIGATORIA) ----
ALLOWED_ORIGINS=https://aubaestudio.com,https://www.aubaestudio.com
# Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_AQUI

# ---- Administrador (OBLIGATORIAS) ----
ADMIN_PHONE=3001234567
ADMIN_PASSWORD=CONTRASENA_FUERTE_UNICA

NODE_ENV=production

# ---- Nequi ----
NEQUI_NUMBER=3001234567

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ---- WhatsApp Business Cloud API ----
WHATSAPP_TOKEN=tu_whatsapp_token
WHATSAPP_PHONE_ID=tu_phone_id
WHATSAPP_BUSINESS_PHONE=573134672623

# ---- ePayco (opcional, desactivado por defecto) ----
# El cobro real es por Nequi con verificación manual. Si integras ePayco, define
# EPAYCO_WEBHOOK_SECRET para que /api/payments/confirm deje de responder 503.
EPAYCO_PUBLIC_KEY=tu_public_key
EPAYCO_WEBHOOK_SECRET=un_secreto_compartido_con_epayco
EPAYCO_TEST_MODE=true
